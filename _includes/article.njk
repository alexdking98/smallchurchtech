---
layout: base.njk
---

<article class="article-page">
    <div class="article-header">
        <div class="container">
            <div class="article-header-content">
                <div class="breadcrumbs">
                    <a href="/">Home</a>
                    <span>›</span>
                    <a href="/#{{ category | lower | replace(' ', '-') }}">{{ category }}</a>
                    <span>›</span>
                    <span>{{ title }}</span>
                </div>
                <h1>{{ title }}</h1>
                <p class="article-deck">{{ description }}</p>
                <div class="article-meta-header">
                    <div class="author-info">
                        <div class="author-avatar">AD</div>
                        <div>
                            <div class="author-name">{{ author or "Alex Daniels" }}</div>
                            <div class="publish-date">Published {{ date | dateDisplay }}</div>
                        </div>
                    </div>
                    <div class="article-share">
                        <span>Share:</span>
                        <a href="https://twitter.com/intent/tweet?url=https://smallchurchtech.com{{ page.url }}&text={{ title }}" class="share-link" target="_blank">Twitter</a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=https://smallchurchtech.com{{ page.url }}" class="share-link" target="_blank">Facebook</a>
                        <a href="mailto:?subject={{ title }}&body=Check this out: https://smallchurchtech.com{{ page.url }}" class="share-link">Email</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-narrow">
        <div class="article-body">
            {{ content | safe }}
            
            {% if products and products.length > 0 %}
            <section class="products-reviewed">
                <h2>Products Reviewed</h2>
                <div class="products-grid">
                    {% for product in products %}
                    <div class="product-card">
                        <h3>{{ product.name }}</h3>
                        <div class="product-price">{{ product.price }}</div>
                        <div class="product-rating">Rating: {{ product.rating }}/10</div>
                        <div class="product-links">
                            {% if product.amazonLink %}
                            <a href="{{ product.amazonLink }}" class="btn btn-primary" target="_blank" rel="nofollow">View on Amazon</a>
                            {% endif %}
                            {% if product.sweetwaterLink %}
                            <a href="{{ product.sweetwaterLink }}" class="btn btn-secondary" target="_blank" rel="nofollow">View on Sweetwater</a>
                            {% endif %}
                            {% if product.bhLink %}
                            <a href="{{ product.bhLink }}" class="btn btn-secondary" target="_blank" rel="nofollow">View on B&H</a>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>
            {% endif %}
            
            <!-- Newsletter CTA -->
            <div class="article-newsletter-cta">
                <h3>Want More Church Tech Reviews?</h3>
                <p>Get weekly gear recommendations and buying guides delivered to your inbox. No spam, just practical advice.</p>
                <form class="inline-newsletter-form">
                    <input type="email" placeholder="your.email@church.org" required>
                    <button type="submit" class="btn btn-primary">Subscribe Free</button>
                </form>
            </div>
        </div>
    </div>
</article>

<!-- Related Articles -->
<section class="related-articles">
    <div class="container">
        <h2>Related Guides</h2>
        <div class="related-grid">
            {% for related in collections.articles | reverse | limit(3) %}
            {% if related.url != page.url %}
            <a href="{{ related.url }}" class="related-card">
                <h4>{{ related.data.title }}</h4>
                <p>{{ related.data.category }}</p>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
