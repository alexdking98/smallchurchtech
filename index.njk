---
layout: base.njk
title: Small Church Tech | Honest Gear Reviews for Church Tech Directors
description: Real-world reviews of audio, video, and lighting equipment for small churches. Budget-conscious recommendations from a working tech director.
---

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Honest Gear Reviews for Small Church Tech Directors</h1>
            <p class="hero-subtitle">Real-world testing. Budget-conscious recommendations. No BS.</p>
            <div class="hero-cta">
                <a href="#featured" class="btn btn-primary">See Latest Reviews</a>
                <a href="#guides" class="btn btn-secondary">Browse Buying Guides</a>
            </div>
        </div>
    </div>
</section>

<!-- Trust Bar -->
<section class="trust-bar">
    <div class="container">
        <div class="trust-items">
            <div class="trust-item">
                <span class="trust-icon" aria-hidden="true">✓</span>
                <span>Tested in Real Worship Environments</span>
            </div>
            <div class="trust-item">
                <span class="trust-icon" aria-hidden="true">✓</span>
                <span>Budget-Focused Recommendations</span>
            </div>
            <div class="trust-item">
                <span class="trust-icon" aria-hidden="true">✓</span>
                <span>Backed by 10+ Years Experience</span>
            </div>
        </div>
    </div>
</section>

<!-- Featured Articles (Dynamic from CMS) -->
<section id="featured" class="featured-section">
    <div class="container">
        <h2 class="section-title">Latest Reviews & Guides</h2>
        
        <div class="articles-grid">
            {% for article in collections.articles | reverse | limit(3) %}
            <article class="article-card {% if loop.first %}featured{% endif %}">
                <div class="article-image">
                    {% if article.data.image %}
                    <img src="{{ article.data.image }}" alt="{{ article.data.imageAlt or article.data.title }}" loading="lazy">
                    {% else %}
                    <img src="https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?w=800&h=450&fit=crop" alt="{{ article.data.title }}" loading="lazy">
                    {% endif %}
                    <span class="article-badge">{{ article.data.category }}</span>
                </div>
                <div class="article-content">
                    <div class="article-meta">
                        <span class="category">{{ article.data.category }}</span>
                        <span class="read-time">{{ article.templateContent | wordcount | divide(200) | round }} min read</span>
                    </div>
                    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
                    <p>{{ article.templateContent | striptags | excerpt }}</p>
                    <div class="article-footer">
                        <a href="{{ article.url }}" class="read-more">Read Full Review →</a>
                        <span class="updated">{{ article.data.date | dateDisplay }}</span>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section">
    <div class="container">
        <h2 class="section-title">Browse by Category</h2>
        <div class="categories-grid">
            <a href="#audio" class="category-card">
                <div class="category-icon" aria-hidden="true">🎤</div>
                <h3>Audio Equipment</h3>
                <p>Mics, mixers, speakers, and processors</p>
                <span class="category-count">{{ collections.articles | filter('category', 'Audio Equipment') | length }} reviews</span>
            </a>
            <a href="#video" class="category-card">
                <div class="category-icon" aria-hidden="true">🎥</div>
                <h3>Video & Streaming</h3>
                <p>Cameras, encoders, and switchers</p>
                <span class="category-count">{{ collections.articles | filter('category', 'Video Equipment') | length }} reviews</span>
            </a>
            <a href="#lighting" class="category-card">
                <div class="category-icon" aria-hidden="true">💡</div>
                <h3>Lighting Systems</h3>
                <p>LED fixtures, controllers, and design</p>
                <span class="category-count">{{ collections.articles | filter('category', 'Lighting') | length }} reviews</span>
            </a>
            <a href="#software" class="category-card">
                <div class="category-icon" aria-hidden="true">💻</div>
                <h3>Software & Apps</h3>
                <p>Presentation, planning, and management</p>
                <span class="category-count">{{ collections.articles | filter('category', 'Software') | length }} reviews</span>
            </a>
        </div>
    </div>
</section>

<!-- Newsletter CTA -->
<section class="newsletter-section">
    <div class="container">
        <div class="newsletter-content">
            <h2>Stay Updated on New Reviews</h2>
            <p>Get weekly gear recommendations, buying guides, and insider tips delivered to your inbox.</p>
            <form class="newsletter-form">
                <input type="email" placeholder="Enter your email" required aria-label="Email for newsletter">
                <button type="submit">Subscribe Free</button>
            </form>
            <p class="privacy-note">No spam, ever. Unsubscribe with one click.</p>
        </div>
    </div>
</section>
